<!DOCTYPE html>
<html lang="fa">
<head>
  <meta charset="UTF-8">
  <title>APZ Wallet — چندزبانه</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: radial-gradient(circle at top, #4f46e5, #020617);
      color: #e5e7eb;
      direction: rtl;
      transition: all .3s ease;
    }
    .container {
      max-width: 960px;
      margin: auto;
      padding: 32px;
    }
    .lang-switch {
      text-align: left;
      margin-bottom: 20px;
    }
    .lang-switch button {
      background: #22c55e;
      border: none;
      padding: 8px 16px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
      margin-left: 8px;
    }
    .hero {
      text-align: center;
      padding: 40px 0;
    }
    .hero img {
      width: 120px;
      margin-bottom: 16px;
    }
    .hero h1 {
      font-size: 2.4rem;
      margin-bottom: 8px;
    }
    .hero p {
      font-size: 1.1rem;
      opacity: 0.9;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-top: 40px;
    }
    .card {
      background: rgba(15, 23, 42, 0.9);
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 0 30px rgba(79, 70, 229, 0.4);
      text-align: center;
    }
    .card h2 {
      margin-top: 0;
      font-size: 1.3rem;
    }
    .footer {
      text-align: center;
      padding: 24px;
      opacity: 0.7;
      margin-top: 40px;
    }
    a {
      color: #22c55e;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>

<div class="container">

  <!-- Language Switch -->
  <div class="lang-switch">
    <button onclick="setLang('fa')">فارسی</button>
    <button onclick="setLang('en')">English</button>
  </div>

  <!-- Hero -->
  <div class="hero">
    <img src="assets/highres-icon.png" alt="APZ Wallet">
    <h1 id="title">کیف‌پول APZ</h1>
    <p id="subtitle">کیف‌پول سبک، امن و متن‌باز برای APZ Chain — ساخته‌شده توسط خلیل حیرانی</p>
    <p>
      <a href="https://github.com/asanpardaz/apz-wallet" id="github-link">مشاهده در گیت‌هاب</a>
    </p>
  </div>

  <!-- Cards -->
  <div class="cards">
    <div class="card">
      <h2 id="android-title">نسخه اندروید</h2>
      <p id="android-desc">ساخته‌شده با Kotlin + Compose، تولید کلید محلی، UI نئونی.</p>
      <a href="https://github.com/asanpardaz/apz-wallet/tree/main/android" id="android-link">مشاهده ماژول اندروید</a>
    </div>

    <div class="card">
      <h2 id="web-title">نسخه وب</h2>
      <p id="web-desc">HTML/CSS/JS — اجرا در مرورگر بدون نیاز به سرور.</p>
      <a href="https://github.com/asanpardaz/apz-wallet/tree/main/web" id="web-link">مشاهده نسخه وب</a>
    </div>

    <div class="card">
      <h2 id="core-title">هسته و رمزنگاری</h2>
      <p id="core-desc">TypeScript Core + Rust Crypto برای تولید آدرس و امضا.</p>
      <a href="https://github.com/asanpardaz/apz-wallet/tree/main/core" id="core-link">Core</a> ·
      <a href="https://github.com/asanpardaz/apz-wallet/tree/main/crypto" id="crypto-link">Crypto</a>
    </div>

    <div class="card">
      <h2 id="rpc-title">RPC و تست‌ها</h2>
      <p id="rpc-desc">Go RPC Client + ماتریس کامل تست‌ها (CPU، GPU، RAM، شبکه، بلاک‌چین).</p>
      <a href="https://github.com/asanpardaz/apz-wallet/tree/main/network" id="rpc-link">RPC</a> ·
      <a href="https://github.com/asanpardaz/apz-wallet/tree/main/.github/workflows" id="ci-link">CI/CD</a>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer" id="footer">
    کیف‌پول APZ · © 2026 خلیل حیرانی · متن‌باز در GitHub
  </div>

</div>

<script>
  const fa = {
    title: "کیف‌پول APZ",
    subtitle: "کیف‌پول سبک، امن و متن‌باز برای APZ Chain — ساخته‌شده توسط خلیل حیرانی",
    github: "مشاهده در گیت‌هاب",

    androidTitle: "نسخه اندروید",
    androidDesc: "ساخته‌شده با Kotlin + Compose، تولید کلید محلی، UI نئونی.",
    androidLink: "مشاهده ماژول اندروید",

    webTitle: "نسخه وب",
    webDesc: "HTML/CSS/JS — اجرا در مرورگر بدون نیاز به سرور.",
    webLink: "مشاهده نسخه وب",

    coreTitle: "هسته و رمزنگاری",
    coreDesc: "TypeScript Core + Rust Crypto برای تولید آدرس و امضا.",

    rpcTitle: "RPC و تست‌ها",
    rpcDesc: "Go RPC Client + ماتریس کامل تست‌ها (CPU، GPU، RAM، شبکه، بلاک‌چین).",

    footer: "کیف‌پول APZ · © 2026 خلیل حیرانی · متن‌باز در GitHub"
  };

  const en = {
    title: "APZ Wallet",
    subtitle: "Lightweight, secure and open‑source wallet for APZ Chain — built by Khalil Heyrani",
    github: "View on GitHub",

    androidTitle: "Android Client",
    androidDesc: "Built with Kotlin + Compose, local key generation, neon UI.",
    androidLink: "Open Android module",

    webTitle: "Web Client",
    webDesc: "HTML/CSS/JS — runs fully in browser, no backend required.",
    webLink: "Open Web version",

    coreTitle: "Core & Crypto",
    coreDesc: "TypeScript Core + Rust Crypto for address generation and signing.",

    rpcTitle: "RPC & Test Matrix",
    rpcDesc: "Go RPC Client + full CI/CD test matrix (CPU, GPU, RAM, Network, Blockchain).",

    footer: "APZ Wallet · © 2026 Khalil Heyrani · Open‑Source on GitHub"
  };

  function setLang(lang) {
    const dict = lang === 'fa' ? fa : en;

    document.body.style.direction = lang === 'fa' ? 'rtl' : 'ltr';

    document.getElementById('title').innerText = dict.title;
    document.getElementById('subtitle').innerText = dict.subtitle;
    document.getElementById('github-link').innerText = dict.github;

    document.getElementById('android-title').innerText = dict.androidTitle;
    document.getElementById('android-desc').innerText = dict.androidDesc;
    document.getElementById('android-link').innerText = dict.androidLink;

    document.getElementById('web-title').innerText = dict.webTitle;
    document.getElementById('web-desc').innerText = dict.webDesc;
    document.getElementById('web-link').innerText = dict.webLink;

    document.getElementById('core-title').innerText = dict.coreTitle;
    document.getElementById('core-desc').innerText = dict.coreDesc;

    document.getElementById('rpc-title').innerText = dict.rpcTitle;
    document.getElementById('rpc-desc').innerText = dict.rpcDesc;

    document.getElementById('footer').innerText = dict.footer;
  }
</script>

</body>
</html>
